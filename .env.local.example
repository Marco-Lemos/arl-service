# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Supabase — Project Settings > API in the Supabase dashboard.
# Use the "publishable" key (starts with sb_publishable_...), not the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Lead notification — the LeadForm's server action uses whichever of these
# is set (both is fine too); if neither is set, leads still save, just silently.
# Resend (transactional email)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL_TO=leads@arlservice.online
# ...or an inbound webhook (Slack, Make, Zapier, n8n, etc.)
LEAD_NOTIFICATION_WEBHOOK_URL=

# Server-only key for a future authenticated /admin area (managing lead status).
# NEVER prefix this with NEXT_PUBLIC_ and never import it from a Client Component.
# SUPABASE_SERVICE_ROLE_KEY=
